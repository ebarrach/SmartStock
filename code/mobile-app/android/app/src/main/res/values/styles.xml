<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/smartstock_app_background</item>
    </style>

    <style name="SmartStockStartingTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/smartstock_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/smartstock_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:statusBarColor">@color/smartstock_splash_background</item>
        <item name="android:navigationBarColor">@color/smartstock_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
